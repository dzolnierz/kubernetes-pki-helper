apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: %CA.CRT%
    server: %SERVER%
  name: %CLUSTER%
contexts:
- context:
    cluster: %CLUSTER%
    namespace: default
    user: %USER%
  name: default
current-context: default
kind: Config
preferences: {}
users:
- name: %USER%
  user:
    client-certificate-data: %CLIENT.CRT%
    client-key-data: %CLIENT.KEY%
    username: %USER%
